---
// Shared styles for the Leaflet maps (markers are built in src/scripts/maps.ts, outside Astro's scoped CSS).
---

<style is:global>
  .amap, .omap { width: 100%; border-radius: 10px; border: 1px solid var(--bd); z-index: 0; }
  .amap { height: min(72vh, 640px); }
  .omap { height: min(60vh, 520px); }
  .num-icon span {
    display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%;
    color: #fff; font: 700 12px/1 -apple-system, sans-serif; border: 2px solid #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
  }
  .bto-icon span {
    display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 5px;
    color: #fff; font: 700 13px/1 -apple-system, sans-serif; border: 2px solid #fff; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
  }
  .site-icon span { display: block; width: 18px; height: 18px; border-radius: 50%; background: #e60000; border: 3px solid #fff; box-shadow: 0 0 0 2px #e60000, 0 2px 6px rgba(0, 0, 0, 0.5); }
  .site-icon b {
    position: absolute; left: 24px; top: -4px; white-space: nowrap; background: #e60000; color: #fff; font: 700 13px/1 -apple-system, sans-serif;
    padding: 5px 8px; border-radius: 4px; box-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }
  .ring-label { font: 700 12px/18px -apple-system, sans-serif; text-align: center; color: #333; background: rgba(255, 255, 255, 0.85); border-radius: 4px; }
  .leaflet-control-layers-overlays label, .leaflet-control-layers-base label { font-size: 13px; }
  .lg { display: inline-block; width: 11px; height: 11px; border-radius: 50%; margin: 0 5px 0 2px; vertical-align: -1px; }
  .lg.site { background: #e60000; border: 2px solid #fff; box-shadow: 0 0 0 1.5px #e60000; }
  .lg.ring { border: 2px dashed #e60000; background: none; }
  .lg.line { border-radius: 0; height: 3px; vertical-align: 3px; width: 16px; background: #6c3483; }
  .lg.bto { border-radius: 2px; background: #1d2329; }
  .lg.uc { border-radius: 2px; background: rgba(255, 140, 0, 0.5); border: 2px solid #ff8c00; }
  .leaflet-popup-content { font-size: 13px; line-height: 1.45; }
  .leaflet-popup-content .pc { color: var(--mut); }
  .proj-label { font-weight: 600; font-size: 12px; padding: 1px 6px; }
</style>
