---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  caption: string;
  wide?: boolean;
}
const { src, caption, wide = false } = Astro.props;
const alt = caption.split('.')[0];
---

{
  src && (
    <figure class:list={{ wide }}>
      <a class="zoom" href={src.src}>
        <Image src={src} alt={alt} widths={wide ? [800, 1200, 2000] : [600, 1000]} sizes={wide ? '(max-width: 1180px) 100vw, 1130px' : '(max-width: 800px) 100vw, 560px'} />
      </a>
      <figcaption>{caption}</figcaption>
    </figure>
  )
}

<style>
  .wide { grid-column: 1 / -1; }
</style>
