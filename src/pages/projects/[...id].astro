---
import Layout from '../../layouts/Layout.astro';
import Figure from '../../components/Figure.astro';
import MapStyles from '../../components/MapStyles.astro';
import { getProjects, sgTime, url, type PastLaunch, type Project } from '../../lib/data';
import pastRates from '../../data/past-rates.json';
import { banding, FLOOR_SHARE } from '../../lib/banding';
import { cat, CLS_COLOUR, metres, money, tagColour, tagify, walk } from '../../lib/format';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { id: p.id },
    props: { p, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props {
  p: Project;
  prev?: Project;
  next?: Project;
}
const { p, prev, next } = Astro.props;
const o = p.official;

// Report body: drop the title line (shown in the header) and style the status tags
const body = tagify((p.entry.rendered?.html ?? '').replace(/^\s*<h1[^>]*>[\s\S]*?<\/h1>/, ''));
const headings = (p.entry.rendered?.metadata?.headings ?? []).filter((h) => h.depth === 2 || h.depth === 3);

const clawback = o.clawback_rate?.startsWith('Not applicable') ? 'None' : o.clawback_rate || (p.upcoming ? 'TBA' : 'None');
const facts: [string, string][] = [
  ['Exercise', p.month === '2026-11' ? 'Nov 2026 (applications close 11 Nov)' : 'Feb 2027 (upcoming)'],
  ['Town', o.town],
  ['Total units', p.totalUnits ? p.totalUnits.toLocaleString('en-US') : '–'],
  ['Clawback', clawback],
  ['Est. waiting time', o.est_waiting_time || 'Not announced'],
  ['Est. completion (ECD)', o.ecd || 'Not announced'],
  ['Delivery date (DPD)', o.dpd || 'Not announced'],
];

const img = p.images;
const perspectives = Object.keys(img).filter((k) => k.includes('perspective')).sort();
// Floor plans grouped by flat type, in HDB's order; landscape sheets (plan plus artist's impression) span both columns
const planGroups = [...Map.groupBy(p.layouts, (l) => l.flat_type)];
const planDefault = planGroups.find(([t]) => t === '4-room')?.[0] ?? planGroups[0]?.[0];
// HDB's charts per flat type: launch prices against nearby resale flats, and an illustrative affordability breakdown
const charts = [['2rm', '2-room Flexi'], ['3rm', '3-room'], ['4rm', '4-room'], ['5rm', '5-room']]
  .map(([k, label]) => ({ label, resale: img[`chart-resale-${k}.jpg`], afford: img[`chart-oydh-${k}.jpg`] }))
  .filter((c) => c.resale || c.afford);
const chartDefault = charts.find((c) => c.label === '4-room')?.label ?? charts[0]?.label;
const models = p.models?.models ?? [];
const retrieved = p.models && new Date(p.models.retrieved).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const planCaption = (l: (typeof p.layouts)[number]) =>
  `${l.flat_type} floor plan${l.variant ? ` (${l.variant})` : ''}: about ${l.area_sqm} m², of which ${l.internal_sqm} m² is internal floor area and the rest the air-con ledge. HDB Layout Ideas, with suggested furniture.${l.note ? ' ' + l.note : ''}`;

const amenities = p.amenities.map((a, i) => {
  const [colour, label] = cat(a.category);
  return { n: i + 1, a, colour, label, straight: metres(a.straight_m), walk: walk(a) };
});
// Nearby BTO projects, nearest first, lettered A, B, C... on the map and in the table
const PRE_COLOUR = '#5d6d7e';
const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
const competitors = [...(p.competition?.projects ?? [])]
  .sort((a, b) => a.straight_m - b.straight_m)
  .map((c, i) => ({ key: String.fromCharCode(65 + i), c, colour: CLS_COLOUR[c.classification] ?? PRE_COLOUR }));
const rules = (c: (typeof competitors)[number]['c']) => (c.open_market === null ? 'Resale rules not yet announced' : c.open_market ? 'Open market' : 'Restricted buyers');
const within = (m: number) => competitors.filter(({ c }) => c.straight_m <= m);
const unitsSum = (list: typeof competitors) => list.reduce((n, { c }) => n + (c.units ?? 0), 0);
const near1k = within(1000);
const compSummary = near1k.length
  ? `${near1k.length} BTO project${near1k.length > 1 ? 's' : ''} within 1 km, about ${unitsSum(near1k).toLocaleString('en-US')} flats: ` +
    `${unitsSum(near1k.filter(({ c }) => c.open_market === true)).toLocaleString('en-US')} sell on the open market and ` +
    `${unitsSum(near1k.filter(({ c }) => c.open_market === false)).toLocaleString('en-US')} only to BTO-eligible buyers (Plus or Prime).`
  : 'No other BTO project within 1 km.';
const rs = p.competition?.resale ?? null;
const AGE_COLOUR: Record<string, string> = { 'Under 10 years': '#1a9850', '10–19 years': '#91cf60', '20–29 years': '#e3c13b', '30–39 years': '#fc8d59', '40+ years': '#d73027' };
const ageBand = (age: number) => (age < 10 ? 'Under 10 years' : age < 20 ? '10–19 years' : age < 30 ? '20–29 years' : age < 40 ? '30–39 years' : '40+ years');
const pct = (n: number, d: number) => (d ? Math.round((100 * n) / d) : 0);
const under20 = rs ? rs.age_at_sale.filter((a) => a.band === 'Under 10 years' || a.band === '10–19 years').reduce((n, a) => n + a.flats, 0) : 0;
const ar = p.appRates;
const RATE_COLS = [['first_time_fam', 'First-timer families'], ['second_time_fam', 'Second-timer families'], ['first_time_singles', 'First-timer singles'], ['elderly', 'Seniors']] as const;
const rateCols = ar ? RATE_COLS.filter(([k]) => ar.rows.some((r) => r.rates[k] != null)) : [];
const rateClass = (v: number | null) => (v == null ? '' : v < 1 ? 'r-low' : v < 3 ? 'r-mid' : 'r-high');
// Earlier 2026 launches (HDB final figures): rows in this town, and every 4-room row for an island-wide view
const past = (pastRates as { launches: PastLaunch[] }).launches;
const isMe = (r: PastLaunch['rows'][number]) => r.projects.some((x) => p.name.startsWith(x.name) || x.name.startsWith(p.name));
const pastTown = past.flatMap((l) => l.rows.filter((r) => r.town === o.town && !isMe(r)).map((r) => ({ l, r })));
const past4 = past.flatMap((l) => l.rows.filter((r) => r.flat_type === '4-Room' && r.rates.first_time_fam != null).map((r) => ({ l, r })))
  .sort((a, b) => b.r.rates.first_time_fam! - a.r.rates.first_time_fam!);
const launchLabel = (l: PastLaunch) => (l.final ? l.launch : `${l.launch} (live)`);
const projNames = (r: PastLaunch['rows'][number]) => r.projects.map((x) => x.name).join(', ');
const projCls = (r: PastLaunch['rows'][number]) => [...new Set(r.projects.map((x) => x.cls).filter(Boolean))].join('/');
const ft4 = ar?.rows.find((r) => r.flat_type === '4-Room')?.rates.first_time_fam ?? null;
const ft = p.fittings;
const pkgPrice = (k: { price: number | null; price_text: string | null }) => (k.price != null ? money(k.price) : k.price_text ?? '–');
const pkgName = (n: string) => n.replace(/^Default \(with bedroom walls\) - OCS opt-in\s*[-–]\s*/, '').replace(/^Package \d+ - /, '');
// Blocks and stacks from HDB's site plan, and estimated price banding by storey
const bk = p.blocks;
const TYPE_COLS: [string, string][] = [
  ['Community Care Apartment', 'CCA'], ['2-room Flexi (Type 1)', '2-room Flexi Type 1'], ['2-room Flexi (Type 2)', '2-room Flexi Type 2'],
  ['3-room', '3-room'], ['4-room', '4-room'], ['5-room', '5-room'], ['3Gen', '3Gen'], ['Rental', 'Rental'],
];
const bkCols = bk ? TYPE_COLS.filter(([k]) => bk.blocks.some((b) => b.counts[k])) : [];
const shortType = (k: string) => TYPE_COLS.find(([x]) => x === k)?.[1] ?? k;
const perFloor = (b: NonNullable<typeof bk>['blocks'][number]) =>
  Object.entries(b.counts).map(([k, n]) => `${Math.round(n / (b.top - 1))} × ${shortType(k)}`).join(', ');
const bkTops = bk ? bk.blocks.map((b) => b.top) : [];
const bkRental = bk ? bk.blocks.reduce((n, b) => n + (b.counts['Rental'] ?? 0), 0) : 0;
const bkSummary = bk
  ? `${bk.blocks.length} blocks, ${Math.min(...bkTops) === Math.max(...bkTops) ? `all ${bkTops[0]}` : `${Math.min(...bkTops)} to ${Math.max(...bkTops)}`} storeys, ` +
    `with ${bk.blocks.reduce((n, b) => n + b.total, 0).toLocaleString('en-US')} flats` + (bkRental ? `, of which ${bkRental} are rental flats not for sale.` : '.')
  : '';
const bands = bk && o.units?.length ? banding(o.units, bk) : [];
const hundreds = (v: number) => money(Math.round(v / 100) * 100);
const thousands = (v: number) => money(Math.round(v / 1000) * 1000);
const legend = [...new Map(amenities.map(({ colour, label }) => [label, colour])).entries()].map(([label, colour]) => [colour, label]);
const mapConfig = JSON.stringify({
  name: p.name,
  lat: o.lat,
  lng: o.lng,
  geo: url(`geo/${p.id}.json`),
  amenities: amenities.map(({ n, a, colour, label, straight, walk }) => ({
    n, colour, label, straight, walk, name: a.name, cat: a.category, lat: a.lat, lng: a.lng, note: a.note ?? '', source: a.source ?? '',
  })),
  competitors: competitors.map(({ key, c, colour }) => ({
    key, colour, name: c.name, lat: c.lat, lng: c.lng,
    popup:
      `<b>${key}. ${esc(c.name)}</b><br><span class="pc">${esc(c.classification)}${c.launch ? ` · launched ${esc(c.launch)}` : ''} · ${rules(c)}</span>` +
      `<br>${metres(c.straight_m)} away · ${c.units ? `${c.units.toLocaleString('en-US')} units` : 'units n/a'}` +
      `<br>${esc(c.status)}${c.completion ? `, completion ${esc(c.completion)}` : ''}` +
      (c.resale_from ? `<br>Earliest resale: ${esc(c.resale_from)}` : '') +
      (c.note ? `<br>${esc(c.note)}` : ''),
  })),
  resaleLabel: rs ? `HDB resale blocks (colour: age in ${rs.sale_year})` : '',
  resale: (rs?.blocks ?? []).map((b) => ({
    lat: b.lat, lng: b.lng, colour: AGE_COLOUR[ageBand(rs!.sale_year - b.year)], r: Math.min(9, 3 + Math.sqrt(b.flats) / 4),
    popup:
      `<b>Blk ${esc(b.blk)} ${esc(b.street)}</b><br><span class="pc">Completed ${b.year} · ${rs!.sale_year - b.year} years old in ${rs!.sale_year}</span>` +
      `<br>${b.flats.toLocaleString('en-US')} sold flats (${esc(b.types)}) · ${metres(b.dist)} away` +
      `<br>Resales ${esc(rs!.window)}: ${b.sales}${b.median_4rm ? ` · 4-room median ${money(b.median_4rm)}` : ''}`,
  })),
});

const s = p.stats;
const uc = s?.hdb_uc_300m ?? [];
const statFacts: [string, string | number][] = s
  ? [
      ['Primary schools within 1 km / 2 km', `${s.primary_1km} / ${s.primary_2km}`],
      ['Hawker centres within 1 km', s.hawker_1km],
      ['Supermarkets within 1 km', s.supermarkets_1km],
      ['CHAS GP clinics within 500 m / 1 km', `${s.clinics_500} / ${s.clinics_1km}`],
      ['Preschools within 500 m', s.preschools_500],
      ['Bus stops within 400 m', s.bus_400],
      ["Site itself in HDB's under-construction list", uc.some((u) => u.dist_m < 40) ? 'Yes' : 'No'],
      [
        'Other HDB blocks under construction within 300 m',
        uc.length ? `${new Set(uc.map((u) => u.blk)).size} blocks, nearest ${Math.min(...uc.map((u) => u.dist_m))} m` : 'None listed',
      ],
    ]
  : [];

const counts: Record<string, number> = {};
for (const v of p.verification) counts[v.status] = (counts[v.status] ?? 0) + 1;
const links = (src?: string) =>
  String(src ?? '')
    .split(/(https?:\/\/[^\s,;)]+)/)
    .map((part, i) => ({ part, isUrl: i % 2 === 1 }));
---

<Layout title={`${p.name}: BTO analysis`} description={`${p.name} (${o.town}, ${p.exercise} BTO): amenities, resale benchmarks, ${o.classification ?? 'likely classification'} rules and waiting time.`}>
  <MapStyles />
  <div class="crumb"><a href={url()}>← All projects</a> · {p.month === '2026-11' ? 'November 2026 BTO' : 'February 2027 BTO (upcoming)'}</div>

  <header class="hero">
    <h1>
      {p.name}{' '}
      {o.classification ? <span class="badge" style={`background:${CLS_COLOUR[o.classification]}`}>{o.classification}</span> : <span class="badge">Classification not yet announced</span>}
    </h1>
    {p.title && p.title !== p.name && <div class="sub">{p.title}</div>}
    <div class="facts">{facts.map(([k, v]) => <div class="fact"><b>{k}</b><span>{v}</span></div>)}</div>
    {
      o.units?.length ? (
        <>
          <h3>Official unit supply and indicative prices (before grants)</h3>
          <div class="tablewrap">
            <table>
              <tr><th>Flat type</th><th>Units</th><th>Floor area (m²)</th><th>Price range</th></tr>
              {o.units.map((u) => (
                <tr>
                  <td>{u.flat_type}</td>
                  <td>{u.supply ?? '–'}</td>
                  <td>{u.floor_area_sqm ?? '–'}</td>
                  <td>{money(u.price_low)} – {money(u.price_high)}</td>
                </tr>
              ))}
            </table>
          </div>
          <p class="sub">2-room Flexi lower bounds include short-lease (15–45 year) options for seniors. Source: HDB project data on the Flat Portal.</p>
        </>
      ) : (
        <p class="sub">
          Official so far: flat types {(o.flat_types ?? []).join(', ')}; {p.totalUnits?.toLocaleString('en-US')} units. Prices, classification and waiting time are announced at launch.
        </p>
      )
    }
    {
      o.waiting_time_note && (
        <details>
          <summary>HDB's completion and delivery note</summary>
          <p>{o.waiting_time_note}</p>
        </details>
      )
    }
  </header>

  {
    (ar?.rows.length || pastTown.length > 0) && (
      <section class="card" id="application-rates">
        {ar ? (<>
        <h2>Application rates {ar.is_final ? '(final)' : '(live, still open)'}</h2>
        <p>
          HDB's {ar.is_final ? 'final' : 'latest'} count, as at {sgTime(ar.as_at)}. Applications {ar.is_final ? 'closed' : 'close'} on {new Date(ar.launch_end).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })}
          {ar.is_final ? '.' : ' at 11:59pm, so these numbers will keep rising.'}
        </p>
        <div class="tablewrap">
          <table class="rates">
            <tr>
              <th>Flat type</th><th>Units</th><th>Applicants</th>
              {rateCols.map(([, label]) => <th>{label}</th>)}
            </tr>
            {ar.rows.map((r) => (
              <tr>
                <td>
                  {r.flat_type}
                  {r.shared_with.length > 0 && <div class="sub">Combined with {r.shared_with.join(', ')}. This project has {r.project_units.toLocaleString('en-US')} of the {r.units.toLocaleString('en-US')} units.</div>}
                </td>
                <td>{r.units.toLocaleString('en-US')}</td>
                <td>{r.applicants.toLocaleString('en-US')}{r.overall != null && <div class="sub">{r.overall.toFixed(1)} per unit</div>}</td>
                {rateCols.map(([k]) => <td class={rateClass(r.rates[k])}>{r.rates[k] != null ? r.rates[k]!.toFixed(1) : '–'}</td>)}
              </tr>
            ))}
          </table>
        </div>
        <p class="sub">
          Each rate is HDB's figure: applicants in that group for each flat set aside for them. Under 1.0 (green) means fewer applicants than flats; above 3.0 (red) means heavy competition, with more than three applicants for every flat.
          Groups get different shares of the flats, so the rates differ from the overall applicants per unit. A dash means the group cannot apply for that flat type.
          Source: <a href={ar.source}>HDB application rate page</a> <span class="tag" style={`background:${tagColour(ar.tag)}`}>{ar.tag}</span>
        </p>
        {ft4 != null && ft4 > 1 && (
          <p>
            Rough odds: there are {ft4.toFixed(1)} first-timer family applicants for every 4-room flat set aside for them, so only about 1 in {Math.round(ft4)} will end up with one here. HDB gives out more queue numbers than there are flats because some applicants decline, so getting a queue number is likelier than that. Families with young children and other priority schemes get extra ballot chances. <span class="tag" style={`background:${tagColour('Estimate')}`}>Estimate</span>.
          </p>
        )}
        </>) : (
          <>
            <h2>Demand guide: earlier launches</h2>
            <p>Application rates are published once this project launches. Until then, the rates of other 2026 launches in {o.town} are the best guide to demand.</p>
          </>
        )}
        {pastTown.length > 0 && (
          <>
            <h3>Other 2026 launches in {o.town}</h3>
            <div class="tablewrap">
              <table class="rates">
                <tr><th>Launch</th><th>Project</th><th>Flat type</th><th>Units</th><th>Applicants</th><th>First-timer families</th><th>Second-timer families</th><th>First-timer singles</th><th>Seniors</th></tr>
                {pastTown.map(({ l, r }) => (
                  <tr>
                    <td class="nw">{launchLabel(l)}</td>
                    <td>{projNames(r)}<div class="sub">{projCls(r)}</div></td>
                    <td>{r.flat_type}</td>
                    <td>{r.units.toLocaleString('en-US')}</td>
                    <td>{r.applicants.toLocaleString('en-US')}</td>
                    {(['first_time_fam', 'second_time_fam', 'first_time_singles', 'elderly'] as const).map((k) => <td class={rateClass(r.rates[k])}>{r.rates[k] != null ? r.rates[k]!.toFixed(1) : '–'}</td>)}
                  </tr>
                ))}
              </table>
            </div>
          </>
        )}
        <details>
          <summary>4-room first-timer family rates at every 2026 launch, highest first</summary>
          <div class="tablewrap">
            <table class="rates">
              <tr><th>Launch</th><th>Town</th><th>Project</th><th>Type</th><th>4-room units</th><th>First-timer families</th></tr>
              {past4.map(({ l, r }) => (
                <tr class={isMe(r) ? 'me' : ''}>
                  <td class="nw">{launchLabel(l)}</td><td>{r.town}</td><td>{projNames(r)}</td><td>{projCls(r)}</td>
                  <td>{r.units.toLocaleString('en-US')}</td><td class={rateClass(r.rates.first_time_fam)}>{r.rates.first_time_fam!.toFixed(1)}</td>
                </tr>
              ))}
            </table>
          </div>
        </details>
        <p class="sub">
          From HDB's application rate pages: final figures for {past.filter((l) => l.final).map((l) => l.launch).join(' and ')}{past.some((l) => !l.final) && `, and the latest count for ${past.filter((l) => !l.final).map((l) => `${l.launch} (as at ${sgTime(l.as_at)}, still open)`).join(', ')}`}. HDB's earlier rate pages are no longer online, so older launches are not shown <span class="tag" style={`background:${tagColour('Official')}`}>Official</span>
        </p>
      </section>
    )
  }

  <section class="card">
    <h2>The plot</h2>
    <div class="gallery">
      <Figure
        wide
        src={img['plot-satellite.jpg']}
        caption="The plot: OneMap satellite view (© OneMap / Singapore Land Authority). Rings at 100 m and 250 m from HDB's site coordinate. Orange outlines are blocks HDB lists as under construction (data.gov.sg). The imagery date is not published and may not show current works."
      />
      <Figure wide src={img['siteplan.jpg']} caption="HDB site plan (official)" />
      <Figure src={img['townmap-crop.jpg']} caption="HDB town map, cropped around the site (official)" />
      <Figure src={img['area-satellite.jpg']} caption="Surroundings: OneMap satellite view, with rings at 500 m and 1 km" />
      {perspectives.map((k, i) => <Figure src={img[k]} caption={`Artist's impression ${i + 1} (HDB)`} />)}
    </div>
  </section>

  {
    bk && (
      <section class="card" id="blocks">
        <h2>Blocks, stacks and price banding</h2>
        <p>{bkSummary} <span class="tag" style={`background:${tagColour(bk.tag)}`}>{bk.tag}</span></p>
        <div class="tablewrap">
          <table class="blk">
            <tr><th>Block</th><th>Storeys</th>{bkCols.map(([, l]) => <th>{l}</th>)}<th>Total</th><th>{bk.blocks.some((b) => b.stacks) ? 'Stacks by flat type' : 'Flats per floor'}</th></tr>
            {bk.blocks.map((b) => (
              <>
                <tr class={b.notes ? 'has-note' : ''}>
                  <td><b>{b.block}</b></td>
                  <td>{b.storeys}</td>
                  {bkCols.map(([k]) => <td>{b.counts[k] ?? '–'}</td>)}
                  <td>{b.total}</td>
                  <td>
                    {b.stacks
                      ? Object.entries(b.stacks).map(([k, list]) => <div><b>{shortType(k)}:</b> {list.join(', ')}</div>)
                      : <span>{perFloor(b)}</span>}
                  </td>
                </tr>
                {b.notes && <tr class="note"><td></td><td colspan={bkCols.length + 3} class="sub">{b.notes}</td></tr>}
              </>
            ))}
          </table>
        </div>
        {bk.notes.length > 0 && <ul>{bk.notes.map((n) => <li>{n}</li>)}</ul>}
        <p class="sub">
          {bk.stack_note}{bk.blocks.some((b) => b.storeys.includes('/')) && ` "${bk.blocks.find((b) => b.storeys.includes('/'))!.storeys}" means the block steps down from ${bk.blocks.find((b) => b.storeys.includes('/'))!.storeys.split('/').reverse().join(' to ')} storeys.`} Source: {bk.source}; the plan itself is in "The plot" above.
        </p>
        {
          bands.length > 0 && (
            <>
              <h3>How the price rises with floor and stack <span class="tag" style={`background:${tagColour('Estimate')}`}>Estimate</span></h3>
              <p>
                HDB publishes only a price range for each flat type. The bottom of the range is a low-floor flat in the least attractive stack. The top is a
                top-floor flat in the best stack. You see each unit's exact price when you book. The table spreads the range over the storeys. I've assumed{' '}
                {Math.round(FLOOR_SHARE * 100)}% of the gap comes from height and the rest from the stack: facing, view, noise and corner units. That split is
                my assumption, not HDB's. <a href="https://mothership.sg/2021/03/high-hdb-floors-sg-experience" target="_blank" rel="noopener">Media reports</a> put
                the BTO floor premium at about $3,000 to $7,000 per storey <span class="tag" style={`background:${tagColour('Unverified')}`}>Unverified</span>.
              </p>
              <div class="tablewrap">
                <table class="band">
                  <tr><th>Storeys</th><th>Estimated price</th><th>Blocks with this flat type at these storeys</th></tr>
                  {bands.map((g) => (
                    <>
                      <tr class="grp">
                        <td colspan="3">
                          <b>{g.flat_type}</b>: {money(g.low)} – {money(g.high)} official, flats up to storey {g.top}. About <b>{hundreds(g.perStorey)}</b> more per
                          storey (between {hundreds(g.perStoreyMin)} and {hundreds(g.perStoreyMax)}). On the same floor, the best stack may cost up to {thousands(g.stackSpread)} more than the cheapest.
                        </td>
                      </tr>
                      {g.bands.map((x) => (
                        <tr><td class="nw">{x.from}–{x.to}</td><td class="nw">{money(x.low)} – {money(x.high)}</td><td>{x.blocks.map((k) => { const top = bk.blocks.find((b) => b.block === k)!.top; return top < x.to ? `${k} (to ${top})` : k; }).join(', ')}</td></tr>
                      ))}
                    </>
                  ))}
                </table>
              </div>
              <p class="sub">
                Each row runs from the cheapest stack at the lowest storey in the band to the best stack at the highest. Rows overlap because a good stack lower
                down can cost as much as a poor stack higher up. {bk.blocks.some((b) => b.storeys.includes('/')) && 'In blocks that step down, some stacks stop at the lower height. '}For 2-room
                Flexi, only the 99-year lease prices are shown. Check the exact unit prices at booking.
              </p>
            </>
          )
        }
      </section>
    )
  }

  <section class="card" id="floor-plans" data-tabs>
    <h2>Floor plans</h2>
    {
      p.layouts.length ? (
        <>
          <p class="sub">
            HDB's "Layout Ideas" for this project, from the Flat Portal. Areas include the air-con ledge. The furniture is only a suggestion, and HDB notes that the coloured plan doesn't mark the boundary of the flat. Click a plan to open it at full size.
          </p>
          <p class="sub">
            {
              models.length ? (
                <>
                  <b>3D models:</b> <a href={p.models!.source} target="_blank" rel="noopener">Btomyhome</a>, a private company, has published free 3D models of {models.length} layouts, built from HDB's brochures (links retrieved {retrieved}). They're unofficial and their dimensions are estimates, so check against HDB's plans. They open in the SketchUp viewer: drag to look around, and use Scenes for preset views.
                </>
              ) : (
                <>
                  <b>3D models:</b> <a href={p.models?.source ?? 'https://btomyhome.com/blogs/news'} target="_blank" rel="noopener">Btomyhome</a> hasn't published free 3D models for this project yet{retrieved ? ` (checked ${retrieved})` : ''}.
                </>
              )
            }
          </p>
          <div class="tabs" role="tablist" aria-label="Flat type">
            {planGroups.map(([type]) => <button role="tab" data-plan={type} aria-selected={String(type === planDefault)}>{type}</button>)}
          </div>
          {
            planGroups.map(([type, plans]) => (
              <div class="gallery panel" role="tabpanel" data-plan={type} hidden={type !== planDefault}>
                {models.some((m) => m.flat_type === type) && (
                  <div class="models">
                    <div class="model-links">
                      {models.filter((m) => m.flat_type === type).map((m) => (
                        <span class="model">
                          <b>3D model{m.variant ? ` (${m.variant})` : ''}</b>
                          <button type="button" data-model={m.url} data-title={m.title}>View here</button>
                          <a href={m.url} target="_blank" rel="noopener">Open in new tab ↗</a>
                        </span>
                      ))}
                    </div>
                    <div class="model-frame"></div>
                  </div>
                )}
                {plans.map((l) => (
                  <Figure src={img[l.image]} wide={img[l.image].width > img[l.image].height * 1.3} caption={planCaption(l)} />
                ))}
              </div>
            ))
          }
        </>
      ) : (
        <p class="sub">HDB publishes floor plans when the project launches for sale. Check the HDB Flat Portal then.</p>
      )
    }
  </section>

  {
    ft && (
      <section class="card" id="fittings">
        <h2>Finishes and optional packages</h2>
        <p>
          What each flat comes with, and what HDB will fit for an extra charge under its Optional Component Scheme (OCS). Each package is optional. If you take one, its price is added to the flat price.
          Fitting these yourself through a contractor can cost more or less, but HDB's work is covered by its defects liability period.
        </p>
        <div class="tablewrap">
          <table class="fit">
            <tr><th>Flat type</th><th>Included as standard</th><th>Optional packages</th></tr>
            {ft.types.map((t) => (
              <tr>
                <td class="nw"><b>{t.flat_type}</b></td>
                <td><ul>{t.standard.map((x) => <li>{x}</li>)}</ul></td>
                <td>
                  {t.packages.length === 0 && <span class="sub">None offered{t.standard.some((x) => /flooring/i.test(x)) ? '. Flooring, doors and sanitary fittings are already included.' : '.'}</span>}
                  {t.packages.map((k) => (
                    <div class="pkg">
                      <b>{pkgName(k.name)}</b>: <span class="nw">{pkgPrice(k)}</span>
                      {k.items.length > 0 && <div class="sub">{k.items.join('; ')}</div>}
                      {k.notes.map((n) => <div class="sub">{n}</div>)}
                    </div>
                  ))}
                  {t.info.map((i) => (
                    <div class="pkg white"><b>{i.title}</b><div class="sub">{i.text}</div></div>
                  ))}
                </td>
              </tr>
            ))}
          </table>
        </div>
        {Object.keys(ft.features).length > 0 && (
          <div class="feats">
            {Object.entries(ft.features).map(([h, list]) => (
              <div><h3>{h}</h3><ul>{list.map((x) => <li>{x}</li>)}</ul></div>
            ))}
          </div>
        )}
        <p class="sub">
          Source: {ft.source}. HDB's OCS leaflets and general specifications are on the project's page on the <a href="https://homes.hdb.gov.sg/home/finding-a-flat">HDB Flat Portal</a> <span class="tag" style={`background:${tagColour(ft.tag)}`}>{ft.tag}</span>
        </p>
      </section>
    )
  }

  {
    charts.length > 0 && (
      <section class="card" id="hdb-charts" data-tabs>
        <h2>HDB's price comparison and affordability</h2>
        <p class="sub">
          HDB's own charts from the Flat Portal. The first compares this project's launch prices with resale flats nearby; HDB's footnotes give the resale flats' remaining leases. The second shows how a typical buyer might pay for a flat at a typical price, with HDB's assumptions listed underneath. For 2-room Flexi, the affordability chart is for Type 2. The resale benchmarks elsewhere on this page come from our own analysis of data.gov.sg transactions.
        </p>
        <div class="tabs" role="tablist" aria-label="Flat type">
          {charts.map((c) => <button role="tab" data-plan={c.label} aria-selected={String(c.label === chartDefault)}>{c.label}</button>)}
        </div>
        {
          charts.map((c) => (
            <div class="gallery panel" role="tabpanel" data-plan={c.label} hidden={c.label !== chartDefault}>
              <Figure src={c.resale} caption={`${c.label}: launch prices against resale flats nearby (HDB, official)`} />
              <Figure src={c.afford} caption={`${c.label}: HDB's illustrative affordability at a typical price, with its assumptions (HDB, official)`} />
            </div>
          ))
        }
      </section>
    )
  }

  <section class="card">
    <h2>Neighbourhood</h2>
    <div class="amap" data-config={mapConfig}></div>
    <p class="legend">
      <span><span class="lg site"></span>BTO site</span>
      {legend.map(([colour, label]) => <span><span class="lg" style={`background:${colour}`}></span>{label}</span>)}
      <span><span class="lg line"></span>Rail line (incl. planned)</span>
      <span><span class="lg uc"></span>HDB blocks under construction</span>
      {competitors.length > 0 && <span><span class="lg bto"></span>Nearby BTO project (lettered)</span>}
      {rs && <span><span class="lg resale"></span>HDB resale block (colour: age in {rs.sale_year})</span>}
      <span><span class="lg ring"></span>500 m / 1 km / 2 km</span>
    </p>
    <p class="sub">
      Live OneMap map. Use the layer button (top right) to switch to satellite, or to show and hide amenity types, rail lines and HDB works. Numbers match the table below; click a row to find it on the map. Rings are at 500 m, 1 km and 2 km. Purple dashed lines are rail alignments from URA Master Plan 2025, including planned lines.
    </p>
    {
      s && (
        <>
          <div class="facts">{statFacts.map(([k, v]) => <div class="fact"><b>{k}</b><span>{v}</span></div>)}</div>
          <p class="sub">
            Counts are straight-line distances from HDB's site coordinate, computed from government datasets on data.gov.sg. School counts use the school's address point; HDB's primary-school priority uses the school boundary, so check individual blocks on OneMap. The under-construction list comes from HDB's 'Under Construction Buildings' dataset (data.gov.sg, updated 15 Oct 2026). It shows blocks already under contract, usually earlier BTO projects nearby. A site that hasn't been launched normally isn't listed yet.
          </p>
        </>
      )
    }
    <div class="tablewrap">
      <table class="amen">
        <tr><th>#</th><th>Type</th><th>Place</th><th>Straight line</th><th>Walk (route estimate)</th><th>Note</th><th>Source</th></tr>
        {
          amenities.map(({ n, a, colour, label, straight, walk }) => (
            <tr data-amenity={n} title="Show on map">
              <td>{n}</td>
              <td style="white-space:nowrap"><span class="dot" style={`background:${colour}`} />{label}</td>
              <td>{a.name}</td>
              <td style="white-space:nowrap">{straight}</td>
              <td style="white-space:nowrap">{walk}</td>
              <td>{a.note}</td>
              <td class="sub">{a.source}</td>
            </tr>
          ))
        }
      </table>
    </div>
    <p class="sub">
      Places and coordinates come from government datasets on data.gov.sg (NEA, LTA, MOE, MOH, ECDA, NParks, PA, NLB, SportSG, URA). Where a dataset gives only an address, the place is located with OneMap search; polyclinics and hospitals come from OneMap search. Straight-line distances are measured from HDB's site coordinate; for MRT stations, to the nearest exit. Walking distances are OpenStreetMap route estimates made by the research agents, shown only where they match the same place. Planned developments and malls come from the research agents, because there is no government dataset for them.
    </p>
  </section>

  {
    p.competition && (
      <section class="card" id="competition">
        <h2>Competition when you sell</h2>
        <h3>New BTO projects nearby</h3>
        <p>{compSummary}</p>
        <p class="sub">
          Other BTO projects nearby whose flats you will be selling against. Compare the earliest resale year with this project's: projects that reach resale in the same few years compete most directly. Letters match the square markers on the map above; click a row to find it. Plus and Prime flats can only be resold to buyers who meet BTO-style eligibility, so they compete with each other for a smaller pool of buyers, while open-market flats nearby are open to anyone.
        </p>
        <div class="tablewrap">
          <table class="amen">
            <tr><th></th><th>Project</th><th>Distance</th><th>Type</th><th>Launched</th><th>Units</th><th>Status</th><th>Earliest resale</th><th>Note</th></tr>
            {
              competitors.map(({ key, c, colour }) => (
                <tr data-bto={key} title="Show on map">
                  <td><span class="key" style={`background:${colour}`}>{key}</span></td>
                  <td><b>{c.name}</b>{c.flat_types && <div class="sub">{c.flat_types}</div>}</td>
                  <td style="white-space:nowrap">{metres(c.straight_m)}</td>
                  <td style="white-space:nowrap">{c.classification}<div class="sub">{rules(c)}</div></td>
                  <td style="white-space:nowrap">{c.launch ?? '–'}</td>
                  <td>{c.units?.toLocaleString('en-US') ?? '–'}</td>
                  <td>{c.status}{c.completion && <div class="sub">Completion {c.completion}</div>}</td>
                  <td style="white-space:nowrap">{c.resale_from ?? '–'}</td>
                  <td>{c.note}<div class="sub">{c.source} <span class="tag" style={`background:${tagColour(c.tag)}`}>{c.tag}</span></div></td>
                </tr>
              ))
            }
          </table>
        </div>
        <p class="sub">{p.competition.method} Updated {p.competition.updated}.</p>
        {
          rs && (
            <>
              <h3>Existing resale flats nearby</h3>
              <p>
                {rs.blocks_count.toLocaleString('en-US')} HDB blocks within 1 km hold {rs.flats.toLocaleString('en-US')} sold flats, and {rs.sales.toLocaleString('en-US')} of them were resold in {rs.window}.
                By {rs.sale_year}, the first year this project's flats can be resold ({rs.sale_note}), {pct(under20, rs.flats)}% of those flats will be under 20 years old <span class="tag" style={`background:${tagColour('Estimate')}`}>Estimate</span>.
              </p>
              <p class="sub">
                These are the flats a buyer could pick instead of yours. Round dots on the map are these blocks, sized by number of flats and coloured by their age in {rs.sale_year}; click one for its recent resales. Prices are today's, not {rs.sale_year}'s. Blocks still being built are not counted here; they are in the BTO table above.
              </p>
              <div class="tablewrap">
                <table class="amen">
                  <tr><th>Flat type</th><th>Sold flats within 1 km</th><th>Resales, last 12 months</th><th>Median price</th><th>Middle half</th><th>Median size</th><th>Young flats resold<div class="sub">lease began in the last 10 years</div></th></tr>
                  {
                    rs.by_type.map((t) => (
                      <tr>
                        <td><b>{t.flat_type}</b></td>
                        <td>{t.stock.toLocaleString('en-US')}</td>
                        <td>{t.sales.toLocaleString('en-US')}{t.turnover_pct != null && <div class="sub">{t.turnover_pct}% of stock</div>}</td>
                        <td>{t.median ? money(t.median) : '–'}</td>
                        <td style="white-space:nowrap">{t.p25 && t.p75 ? `${money(t.p25)} – ${money(t.p75)}` : '–'}</td>
                        <td>{t.median_sqm ? `${t.median_sqm} m²` : '–'}</td>
                        <td>{t.young_sales ? <>{t.young_sales}<div class="sub">median {money(t.young_median!)}</div></> : '–'}</td>
                      </tr>
                    ))
                  }
                </table>
              </div>
              <p><b>Age of those flats in {rs.sale_year}</b></p>
              <div class="agebar">
                {rs.age_at_sale.map((a) => (
                  <span style={`width:${(100 * a.flats) / rs.flats}%;background:${AGE_COLOUR[a.band]}`} title={`${a.band}: ${a.flats.toLocaleString('en-US')} flats`}></span>
                ))}
              </div>
              <ul class="agekey">
                {rs.age_at_sale.map((a) => (
                  <li><i style={`background:${AGE_COLOUR[a.band]}`}></i>{a.band}: {a.flats.toLocaleString('en-US')} flats ({pct(a.flats, rs.flats)}%)</li>
                ))}
              </ul>
              <p class="sub">{rs.method} Source: {rs.source} <span class="tag" style={`background:${tagColour(rs.tag)}`}>{rs.tag}</span></p>
            </>
          )
        }
      </section>
    )
  }

  {
    headings.length > 0 && (
      <section class="card toc">
        <b>Contents</b>
        <ul>
          {headings.map((h) => (
            <li class={`d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="card prose" set:html={body} />

  <section class="card">
    <h2>Verification log</h2>
    {
      p.verification.length ? (
        <>
          <p>
            {Object.entries(counts)
              .sort()
              .map(([k, n]) => (
                <>
                  <span class={`st st-${k}`}>{k}</span> {n}{' '}
                </>
              ))}
          </p>
          <details>
            <summary>Show all changes against the earlier report</summary>
            <div class="tablewrap">
              <table>
                <tr><th>Status</th><th>Item</th><th>Earlier report</th><th>Now</th><th>Source</th></tr>
                {p.verification.map((v) => (
                  <tr>
                    <td><span class={`st st-${v.status}`}>{v.status}</span></td>
                    <td>{v.item}</td>
                    <td>{v.old}</td>
                    <td>{v.new}</td>
                    <td>{links(v.source).map(({ part, isUrl }) => (isUrl ? <a href={part} target="_blank" rel="noopener">link</a> : part))}</td>
                  </tr>
                ))}
              </table>
            </div>
          </details>
        </>
      ) : (
        <p class="sub">No verification log.</p>
      )
    }
    <p class="sub">
      Tags: <span class="tag" style="background:#1e7e34">Official</span> HDB or another government source · <span class="tag" style="background:#2471a3">Verified</span> two or more good sources, or computed from official data · <span class="tag" style="background:#b9770e">Estimate</span> · <span class="tag" style="background:#922b21">Unverified</span>
    </p>
  </section>

  <nav class="pager">
    {prev ? <a href={url(`projects/${prev.id}/`)}>← {prev.name}</a> : <span />}
    {next ? <a href={url(`projects/${next.id}/`)}>{next.name} →</a> : <span />}
  </nav>
</Layout>

<script>
  import '../../scripts/maps';

  // 3D models load in an iframe only when asked for, since the SketchUp viewer is heavy
  document.querySelectorAll<HTMLButtonElement>('button[data-model]').forEach((b) =>
    b.addEventListener('click', () => {
      const box = b.closest('.models')!;
      const frame = box.querySelector<HTMLElement>('.model-frame')!;
      const open = b.textContent === 'Hide';
      box.querySelectorAll<HTMLButtonElement>('button[data-model]').forEach((x) => (x.textContent = 'View here'));
      frame.replaceChildren();
      if (open) return;
      const f = document.createElement('iframe');
      f.src = b.dataset.model!;
      f.title = `${b.dataset.title} (3D model, Btomyhome)`;
      f.allow = 'fullscreen; xr-spatial-tracking';
      f.allowFullscreen = true;
      frame.append(f);
      b.textContent = 'Hide';
    }),
  );

  // Floor plans and HDB charts: show one flat type at a time
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((section) => {
    const tabs = section.querySelectorAll<HTMLButtonElement>('.tabs button');
    tabs.forEach((b) =>
      b.addEventListener('click', () => {
        tabs.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        section.querySelectorAll<HTMLElement>('.panel').forEach((g) => (g.hidden = g.dataset.plan !== b.dataset.plan));
      }),
    );
  });
</script>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 13px; margin: 8px 0 0; }
  .legend > span { white-space: nowrap; }
  .crumb { font-size: 14px; margin-bottom: 10px; }
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 800px) { .gallery { grid-template-columns: 1fr; } }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 14px; }
  .tabs button { border: 1px solid var(--bd); background: #fff; border-radius: 999px; padding: 5px 12px; font: inherit; font-size: 13px; cursor: pointer; }
  .tabs button[aria-selected='true'] { background: #1d2329; border-color: #1d2329; color: #fff; }
  .panel[hidden] { display: none; }
  .models { grid-column: 1 / -1; }
  .model-links { display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; }
  .model { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .model button { border: 1px solid #1d2329; background: #1d2329; color: #fff; border-radius: 6px; padding: 4px 10px; font: inherit; font-size: 13px; cursor: pointer; }
  .model-frame :global(iframe) { display: block; width: 100%; height: min(70vh, 600px); border: 1px solid var(--bd); border-radius: 10px; margin-top: 10px; }
  .panel:has(> figure:only-of-type:not(.wide)) { grid-template-columns: minmax(0, 560px); justify-content: center; }
  .rates td.r-low { color: #1e7e34; font-weight: 600; }
  .rates td.r-mid { color: #b9770e; font-weight: 600; }
  .rates td.r-high { color: #922b21; font-weight: 600; }
  .rates tr.me td { background: #fff7e0; }
  .fit td { vertical-align: top; }
  .fit ul { margin: 0; padding-left: 16px; }
  .pkg { margin-bottom: 6px; }
  .pkg.white { border-left: 3px solid #b9770e; padding-left: 6px; }
  .blk tr.has-note td { border-bottom: 0; }
  .blk tr.note td { padding-top: 0; }
  .blk td:last-child { min-width: 220px; }
  .band tr.grp td { background: #f4f6f8; }
  .feats { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0 24px; }
  .feats ul { margin-top: 0; padding-left: 18px; }
  .toc ul { margin: 4px 0; padding-left: 18px; columns: 2; font-size: 14px; }
  .toc li.d3 { margin-left: 16px; }
  @media (max-width: 700px) { .toc ul { columns: 1; } }
  .amen tr[data-amenity], .amen tr[data-bto] { cursor: pointer; }
  .amen tr[data-amenity]:hover td, .amen tr[data-bto]:hover td { background: #eef5ff; }
  .agebar { display: flex; height: 16px; border-radius: 4px; overflow: hidden; margin: 4px 0 6px; }
  .agekey { list-style: none; padding: 0; margin: 0 0 8px; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 13px; }
  .agekey i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-right: 5px; }
  .key { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 4px; color: #fff; font-weight: 700; font-size: 12px; }
  .pager { display: flex; justify-content: space-between; margin: 0 0 20px; font-weight: 600; }
</style>
